# Resend API key (server-side only)
RESEND_API_KEY=re_your_api_key_here

# Comma-separated list of recipient emails
RECIPIENT_EMAIL=admin@interim.asomovit.com,other@gmail.com

# Public URL of the app
APP_URL=https://interim.asomovit.com

# Google Tag Manager container ID (public)
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Google Analytics Measurement ID (public) – set on the GTM container or directly
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Google reCAPTCHA v3 – site key is public, secret key is server-side only
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_recaptcha_site_key
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key
